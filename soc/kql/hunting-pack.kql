// Secure commerce SOC hunting pack
// Workspace table: ContainerAppConsoleLogs_CL
// Log_s is JSON emitted by the commerce app. All SOC simulations carry a
// validated X-SOC-Scenario-ID value in simulation_id.

// 1. Authentication failures and rate limiting by source
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(24h)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend path = tostring(payload.path), event_type=tostring(payload.event_type), status = toint(payload.status_code), source=tostring(payload.source_ip), simulation_id=tostring(payload.simulation_id)
| where event_type in ("AUTH_LOGIN_FAILURE", "AUTH_ACCOUNT_LOCKED", "RATE_LIMIT_EXCEEDED")
| summarize Attempts=dcount(tostring(payload.request_id)), Failures=dcountif(tostring(payload.request_id), event_type=="AUTH_LOGIN_FAILURE"), Locks=dcountif(tostring(payload.request_id), event_type=="AUTH_ACCOUNT_LOCKED"), FirstSeen=min(todatetime(payload.timestamp)), LastSeen=max(todatetime(payload.timestamp)), RequestIds=make_set(tostring(payload.request_id), 20) by source, simulation_id
| order by Attempts desc

// 2. Password spray candidates: many accounts from one source
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(1h)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend account=tostring(payload.email_hash), simulation_id=tostring(payload.simulation_id)
| where tostring(payload.event_type)=="AUTH_LOGIN_FAILURE" and isnotempty(account)
| summarize Accounts=dcount(account), Attempts=dcount(tostring(payload.request_id)), ObservedSources=make_set(tostring(payload.source_ip)), FirstSeen=min(todatetime(payload.timestamp)), LastSeen=max(todatetime(payload.timestamp)) by simulation_id
| where Accounts >= 3 and Attempts >= 5
| order by Attempts desc

// 3. Suspicious successful login after repeated failures
let failed = ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(30m)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend account=tostring(payload.email_hash), simulation_id=tostring(payload.simulation_id)
| where tostring(payload.event_type)=="AUTH_LOGIN_FAILURE" and isnotempty(account)
| summarize Failures=dcount(tostring(payload.request_id)), LastFailure=max(todatetime(payload.timestamp)) by simulation_id, account;
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(15m)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend account=tostring(payload.email_hash), source=tostring(payload.source_ip), simulation_id=tostring(payload.simulation_id), ActivityTime=todatetime(payload.timestamp)
| where tostring(payload.event_type)=="AUTH_LOGIN_SUCCESS" and isnotempty(account)
| join kind=inner failed on simulation_id, account
| where Failures >= 3 and ActivityTime > LastFailure
| project ActivityTime, source, simulation_id, account, Failures, LastFailure

// 4. API abuse and enumeration
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(1h)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend path = tostring(payload.path), status = toint(payload.status_code), source=tostring(payload.source_ip), simulation_id=tostring(payload.simulation_id)
| where tostring(payload.event_type)=="HTTP_REQUEST" and path startswith "/api/"
| summarize Requests=dcount(tostring(payload.request_id)), DistinctPaths=dcount(path), ErrorResponses=countif(status >= 400), FirstSeen=min(todatetime(payload.timestamp)), LastSeen=max(todatetime(payload.timestamp)) by source, simulation_id
| where Requests >= 50
| order by Requests desc

// 5. Privilege boundary probing
ContainerAppConsoleLogs_CL
| where TimeGenerated > ago(1h)
| extend payload = parse_json(column_ifexists("Log_s", ""))
| extend path = tostring(payload.path), status = toint(payload.status_code), source=tostring(payload.source_ip), simulation_id=tostring(payload.simulation_id)
| where tostring(payload.event_type)=="AUTH_FORBIDDEN"
| summarize Probes=dcount(tostring(payload.request_id)), Paths=make_set(path, 20), ActorIds=make_set(tostring(payload.user_id)), FirstSeen=min(todatetime(payload.timestamp)), LastSeen=max(todatetime(payload.timestamp)) by source, simulation_id
| where Probes >= 3

// 6. Cloud administrative changes
AzureActivity
| where TimeGenerated > ago(24h)
| where ActivityStatusValue =~ "Success"
| where OperationNameValue has_any ("/write", "/delete", "/action")
| project TimeGenerated, Caller, OperationNameValue, ResourceGroup, ResourceId
| order by TimeGenerated desc

// 7. Telemetry health
ContainerAppConsoleLogs_CL
| summarize LastEvent=max(TimeGenerated), Events=count() by bin(TimeGenerated, 15m)
| order by TimeGenerated desc
