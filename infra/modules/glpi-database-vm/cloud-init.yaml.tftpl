#cloud-config
package_update: true
packages:
  - mariadb-server
  - mariadb-client
  - rsync
  - jq
runcmd:
  - bash -c "if ! blkid /dev/disk/azure/scsi1/lun0; then mkfs.ext4 -F /dev/disk/azure/scsi1/lun0; fi"
  - mkdir -p /mnt/mysql-data
  - mount /dev/disk/azure/scsi1/lun0 /mnt/mysql-data
  - systemctl stop mariadb || true
  - bash -c "if [ ! -e /mnt/mysql-data/mysql ]; then rsync -a /var/lib/mysql/ /mnt/mysql-data/; fi"
  - bash -c "echo '/dev/disk/azure/scsi1/lun0 /var/lib/mysql ext4 defaults,nofail 0 2' >> /etc/fstab"
  - mount --bind /mnt/mysql-data /var/lib/mysql
  - chown -R mysql:mysql /mnt/mysql-data
  - systemctl enable --now mariadb
  - bash -c "until mariadb-admin ping --silent; do sleep 5; done"
  - bash -c "mariadb -e \"CREATE DATABASE IF NOT EXISTS glpi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS 'glpiadmin'@'%' IDENTIFIED BY '${database_password}'; ALTER USER 'glpiadmin'@'%' IDENTIFIED BY '${database_password}'; GRANT ALL PRIVILEGES ON glpi.* TO 'glpiadmin'@'%'; FLUSH PRIVILEGES;\""
  - bash -c "sed -i 's/^bind-address.*/bind-address = 0.0.0.0/' /etc/mysql/mariadb.conf.d/50-server.cnf"
  - systemctl restart mariadb
  - bash -c "ufw allow from 10.20.0.0/16 to any port 3306 proto tcp || true"
