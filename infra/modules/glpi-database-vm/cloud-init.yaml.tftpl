#cloud-config
package_update: true
packages:
  - mariadb-server
  - mariadb-client
  - rsync
  - openssl
runcmd:
  - bash -c "if ! blkid /dev/disk/azure/scsi1/lun0; then mkfs.ext4 -F /dev/disk/azure/scsi1/lun0; fi"
  - mkdir -p /mnt/mysql-data
  - mount /dev/disk/azure/scsi1/lun0 /mnt/mysql-data
  - systemctl stop mariadb || true
  - bash -c "if [ ! -e /mnt/mysql-data/mysql ]; then rsync -a /var/lib/mysql/ /mnt/mysql-data/; fi"
  - bash -c "grep -q '/dev/disk/azure/scsi1/lun0 /var/lib/mysql' /etc/fstab || echo '/dev/disk/azure/scsi1/lun0 /var/lib/mysql ext4 defaults,nofail 0 2' >> /etc/fstab"
  - mount --bind /mnt/mysql-data /var/lib/mysql
  - chown -R mysql:mysql /mnt/mysql-data
  - mkdir -p /etc/mysql/ssl
  - bash -c "openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -keyout /etc/mysql/ssl/server-key.pem -out /etc/mysql/ssl/server-cert.pem -subj '/CN=glpi-mariadb'"
  - chown -R mysql:mysql /etc/mysql/ssl
  - bash -c "cat >/etc/mysql/mariadb.conf.d/60-tls.cnf <<'CFG'
[mysqld]
bind-address = 0.0.0.0
ssl-ca = /etc/mysql/ssl/server-cert.pem
ssl-cert = /etc/mysql/ssl/server-cert.pem
ssl-key = /etc/mysql/ssl/server-key.pem
require_secure_transport = ON
CFG"
  - systemctl enable --now mariadb
  - bash -c "until mariadb-admin ping --silent; do sleep 5; done"
  - bash -c "mariadb -e \"CREATE DATABASE IF NOT EXISTS glpi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS 'glpiadmin'@'10.20.%' IDENTIFIED BY '${database_password}'; ALTER USER 'glpiadmin'@'10.20.%' IDENTIFIED BY '${database_password}' REQUIRE SSL; GRANT ALL PRIVILEGES ON glpi.* TO 'glpiadmin'@'10.20.%'; FLUSH PRIVILEGES;\""
  - systemctl restart mariadb
