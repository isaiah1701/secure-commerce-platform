events
| where EventType == "HTTP_REQUEST" and Path !in ("/health", "/ready", "/metrics")
| summarize RequestCount=dcount(RequestId), FirstActivityUtc=min(ActivityTime), LastActivityUtc=max(ActivityTime), ObservedSources=make_set_if(SourceIP, SourceIP!="unknown", 10), AccountHashes=make_set(TargetHash, 20), RequestIds=make_set(RequestId, 30) by SimulationId
| where RequestCount >= 50
