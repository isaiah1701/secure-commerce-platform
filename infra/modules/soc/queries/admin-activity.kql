events
| where EventType == "ADMIN_USERS_VIEWED" and ActorRole == "admin"
| summarize ActivityCount=dcount(RequestId), FirstActivityUtc=min(ActivityTime), LastActivityUtc=max(ActivityTime), ObservedSources=make_set_if(SourceIP, SourceIP!="unknown", 10), AccountHashes=make_set(strcat("user:", ActorId), 20), RequestIds=make_set(RequestId, 30) by SimulationId
| where ActivityCount >= 3
