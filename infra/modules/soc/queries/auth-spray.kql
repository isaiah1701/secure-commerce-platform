events
| where EventType == "AUTH_LOGIN_FAILURE" and isnotempty(TargetHash)
| summarize FailureCount=dcount(RequestId), TargetedAccounts=dcount(TargetHash), FirstActivityUtc=min(ActivityTime), LastActivityUtc=max(ActivityTime), ObservedSources=make_set_if(SourceIP, SourceIP!="unknown", 10), AccountHashes=make_set(TargetHash, 20), RequestIds=make_set(RequestId, 30) by SimulationId
| where FailureCount >= 5 and TargetedAccounts >= 3
