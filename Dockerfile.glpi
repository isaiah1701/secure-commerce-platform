FROM glpi/glpi:11.0.12

# Azure Container Apps does not preserve the official image's cap_net_bind_service
# capability for the non-root www-data process. Run Apache on an unprivileged
# port instead and expose that port through Container Apps ingress.
USER root
RUN sed -i 's/^Listen 80$/Listen 8080/' /etc/apache2/ports.conf \
    && sed -i 's#<VirtualHost \*:80>#<VirtualHost *:8080>#' /etc/apache2/sites-available/000-default.conf \
    && sed -i 's#<VirtualHost \*:80>#<VirtualHost *:8080>#' /etc/apache2/sites-enabled/000-default.conf
COPY glpi-theme/soc_ops.scss /opt/glpi-theme/soc_ops.scss
COPY glpi-theme/entrypoint.sh /usr/local/bin/glpi-entrypoint-with-theme
RUN chmod 0444 /opt/glpi-theme/soc_ops.scss \
    && chmod 0555 /usr/local/bin/glpi-entrypoint-with-theme

USER www-data
ENTRYPOINT ["/usr/local/bin/glpi-entrypoint-with-theme"]
